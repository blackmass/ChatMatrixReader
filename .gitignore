# ---- built or made by the tools (never committed) ----
# build output of Rust (can grow to several GB) and files Tauri generates again on every build
src-tauri/target/
src-tauri/gen/
# the program built by build.bat (any name)
*.exe
# the helper bats of the maintainer (release, git, zips ...) stay on his PC; build.bat (how to build from the sources) is part of the repository
*.bat
!build.bat
# the Mac app made by tools/mac_make_app.command
ChatMatrix Reader.app/
# zip files made for sending / the release
*.zip
release-out/
release-mac/
THIRD-PARTY-NOTICES*.txt
# the engine (engine/stt): what its build leaves
engine/stt/build*/
engine/stt/dist/
tests/browser/out/

# ---- what the program leaves next to itself while it runs (the user's own data) ----
config.json
config.1x.json
usage.json
Glossary.txt
logs/
chatmatrix.log*
webview-data/
# marker files for development (an empty file next to the program)
show_control
mac_no_panel

# the user's fonts: the folder stays (fonts/README.txt tells how to use it), what is put into it does not
fonts/*
!fonts/README.txt

#plugin
plugin-data/
plugins/*
!plugins/README.txt

# the voice recognition installed by the program: engine, models, sounds of the speed test, temporary files
extensions/

# 애드온(ChatMatrix) 소스: 사용자가 따로 관리한다 (이 저장소에는 올리지 않는다)
addon/
*.part

# ---- docs: only what users read is published (the plugin guide). The notes of the maintainer are kept by him, not in this repository ----
docs/*
!docs/README.md
!docs/plugin-guide*.md

# ---- editors and systems ----
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/
node_modules/
