#!/bin/bash
# Double-click launcher: no Terminal window once the first-time setup is done.
SELF="$(cd "$(dirname "$0")/../../.." && pwd)"
LOG="$HOME/ChatMatrixReader-launch.log"
echo "$(date) start from $SELF" >> "$LOG"
case "$SELF" in
  */AppTranslocation/*)
    osascript -e 'display dialog "macOS가 이 앱을 격리된 임시 위치에서 실행하고 있어 폴더를 찾을 수 없습니다.\n\n터미널에서 한 번만 실행해 주세요:\nxattr -dr com.apple.quarantine <ChatMatrixReader 폴더>\n\n(폴더를 터미널 창으로 끌어다 놓으면 경로가 입력됩니다)" with title "ChatMatrix Reader" buttons {"OK"} with icon caution'
    exit 0;;
esac
cd "$SELF" || exit 1
if [ -x .venv/bin/python ] && .venv/bin/python -c "import numpy, Quartz, certifi, ApplicationServices" >> "$LOG" 2>&1; then
    exec .venv/bin/python app/app.py >> "$LOG" 2>&1
fi
echo "setup needed -> Terminal" >> "$LOG"
open -a Terminal "$SELF/run.command"
