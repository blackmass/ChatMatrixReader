# Included by CMakeLists.txt when CMR_WITH_WHISPER is ON: brings in whisper.cpp (official source, the version of whisper.version) and its ggml.
#   -DCMR_WHISPER_DIR=<folder>  use an unpacked copy of the official source (the release zip) instead of fetching it with git
#   -DCMR_GPU=none|vulkan|cuda|metal  which compute backend is built in (none = CPU only). metal = macOS (Apple silicon): the CPU part (Accelerate)
#                               and Metal are in the SAME program; the Metal shaders are embedded in it (no extra file)
#   -DCMR_CPU=avx2|generic      avx2 (default): needs a CPU of 2013 or later (Haswell); generic: every x86-64 CPU, slower (ignored on arm64)
include(FetchContent)

file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/whisper.version" _cmr_wv REGEX "^[a-z_0-9]+=")
foreach(_l ${_cmr_wv})
  if(_l MATCHES "^([a-z_0-9]+)=(.*)$")
    set(CMR_WHISPER_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
  endif()
endforeach()
if(NOT CMR_WHISPER_commit OR NOT CMR_WHISPER_repository)
  message(FATAL_ERROR "whisper.version has no repository / commit")
endif()

set(CMR_WHISPER_DIR "" CACHE PATH "Unpacked official whisper.cpp source (empty = fetch it with git at the commit of whisper.version)")
set(CMR_GPU "none" CACHE STRING "Compute backend: none | vulkan | cuda | metal")
set(CMR_CPU "avx2" CACHE STRING "CPU level: avx2 | generic")

# one program, no extra DLLs: static libraries, no OpenMP runtime, no Visual C++ redistributable
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(WHISPER_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(WHISPER_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(WHISPER_BUILD_SERVER OFF CACHE BOOL "" FORCE)
set(WHISPER_CURL OFF CACHE BOOL "" FORCE)
set(WHISPER_SDL2 OFF CACHE BOOL "" FORCE)
set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
set(GGML_NATIVE OFF CACHE BOOL "" FORCE)                 # (not tuned to the build machine: users have other CPUs)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64|ARM64" OR (APPLE AND CMAKE_OSX_ARCHITECTURES STREQUAL "arm64"))
  set(CMR_CPU "arm64")                                  # (Apple silicon: no x86 flags; ggml picks NEON itself)
elseif(CMR_CPU STREQUAL "avx2")
  set(GGML_AVX2 ON CACHE BOOL "" FORCE)
  set(GGML_FMA ON CACHE BOOL "" FORCE)
  set(GGML_F16C ON CACHE BOOL "" FORCE)
elseif(CMR_CPU STREQUAL "generic")
  set(GGML_AVX2 OFF CACHE BOOL "" FORCE)
  set(GGML_AVX OFF CACHE BOOL "" FORCE)
  set(GGML_FMA OFF CACHE BOOL "" FORCE)
  set(GGML_F16C OFF CACHE BOOL "" FORCE)
endif()
if(NOT CMR_CPU MATCHES "^(avx2|generic|arm64)$")
  message(FATAL_ERROR "CMR_CPU is avx2 or generic")
endif()
if(CMR_GPU STREQUAL "vulkan")
  set(GGML_VULKAN ON CACHE BOOL "" FORCE)
elseif(CMR_GPU STREQUAL "cuda")
  set(GGML_CUDA ON CACHE BOOL "" FORCE)
elseif(CMR_GPU STREQUAL "metal")
  if(NOT APPLE)
    message(FATAL_ERROR "CMR_GPU=metal needs macOS")
  endif()
  set(GGML_METAL ON CACHE BOOL "" FORCE)
  set(GGML_METAL_EMBED_LIBRARY ON CACHE BOOL "" FORCE)  # (the shaders inside the program: one file)
  set(GGML_METAL_NDEBUG ON CACHE BOOL "" FORCE)
  set(GGML_ACCELERATE ON CACHE BOOL "" FORCE)           # (the CPU part: Apple's Accelerate)
  set(GGML_BLAS OFF CACHE BOOL "" FORCE)
elseif(NOT CMR_GPU STREQUAL "none")
  message(FATAL_ERROR "CMR_GPU is none, vulkan, cuda or metal")
endif()

if(CMR_WHISPER_DIR)
  if(NOT EXISTS "${CMR_WHISPER_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "CMR_WHISPER_DIR has no CMakeLists.txt: ${CMR_WHISPER_DIR}")
  endif()
  add_subdirectory("${CMR_WHISPER_DIR}" whisper-build EXCLUDE_FROM_ALL)
  set(CMR_WHISPER_SOURCE "${CMR_WHISPER_DIR}")
else()
  FetchContent_Declare(whisper GIT_REPOSITORY "${CMR_WHISPER_repository}" GIT_TAG "${CMR_WHISPER_commit}")
  FetchContent_MakeAvailable(whisper)
  set(CMR_WHISPER_SOURCE "${CMR_WHISPER_repository}@${CMR_WHISPER_commit}")
endif()
message(STATUS "cmr-stt: whisper.cpp ${CMR_WHISPER_tag} from ${CMR_WHISPER_SOURCE}; GPU: ${CMR_GPU}; CPU: ${CMR_CPU}")

set(CMR_RECOGNIZER_SOURCES src/whisper_engine.cpp)
set(CMR_WHISPER_LIBS whisper)
# what the built engine reports about itself (--version): the same facts that BUILD-INFO.txt states
set(CMR_WHISPER_DEFS CMR_WHISPER_TAG="${CMR_WHISPER_tag}" CMR_WHISPER_COMMIT="${CMR_WHISPER_commit}" CMR_GPU_NAME="${CMR_GPU}" CMR_CPU_NAME="${CMR_CPU}")
